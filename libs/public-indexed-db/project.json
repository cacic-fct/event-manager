{
  "name": "public-indexed-db",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "root": "libs/public-indexed-db",
  "sourceRoot": "libs/public-indexed-db/src",
  "prefix": "lib",
  "projectType": "library",
  "tags": ["scope:public", "type:data-access"],
  "targets": {
    "lint": {
      "inputs": [
        "default",
        "^default",
        "{workspaceRoot}/.eslintrc.json",
        "{workspaceRoot}/.eslintignore",
        "{workspaceRoot}/eslint.config.mjs",
        "{workspaceRoot}/tools/eslint-rules/**/*",
        {
          "externalDependencies": ["eslint"]
        }
      ],
      "options": {
        "args": ["**/*.ts"]
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/coverage/libs/public-indexed-db"],
      "options": {
        "command": "bunx vitest run --coverage --config libs/public-indexed-db/vitest.config.ts"
      }
    }
  }
}

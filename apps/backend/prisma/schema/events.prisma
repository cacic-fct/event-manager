enum EventType {
  MINICURSO
  PALESTRA
  OTHER
}

enum PublicationState {
  DRAFT
  SCHEDULED
  PUBLISHED
  UNPUBLISHED
}

enum PublicationPreviewTargetType {
  EVENT
  EVENT_GROUP
  MAJOR_EVENT
}

model Event {
  id            String    @id @default(uuid(7))
  name          String
  creditMinutes Int?
  startDate     DateTime
  endDate       DateTime
  type          EventType @default(OTHER)
  emoji         String    @default("❔")

  description      String?
  shortDescription String?

  latitude            Float?
  longitude           Float?
  locationDescription String?

  majorEvent   MajorEvent? @relation(fields: [majorEventId], references: [id])
  majorEventId String?

  eventGroup   EventGroup? @relation(fields: [eventGroupId], references: [id])
  eventGroupId String?

  drafts EventDraft[]
  ownedForms    EventForm[]     @relation("EventFormOwnerEvent")
  formLinks     EventFormLink[] @relation("EventFormLinkEvent")
  formResponses EventFormResponse[] @relation("EventFormResponseEvent")

  attendances                   EventAttendance[]
  attendanceCollectors          EventAttendanceCollector[]
  offlineAttendanceSubmissions  OfflineEventAttendanceSubmission[]
  lecturers                     EventLecturer[]
  eventManagerPermissionGrants EventManagerPermissionGrant[]

  allowSubscription     Boolean             @default(false)
  requiresImageLicenseAgreement Boolean     @default(false)
  subscriptionStartDate DateTime?
  subscriptionEndDate   DateTime?
  subscriptions         EventSubscription[]
  slots                 Int?
  slotsAvailable        Int?
  queueCount            Int                 @default(0)
  // When true and only if event is part of a major event, users will be automatically subscribed to this event when subscribing to the major event
  autoSubscribe         Boolean             @default(false)
  majorEventSelections  MajorEventSubscriptionEventSelection[]
  sportsMatch           SportsMatch?

  shouldIssueCertificate                          Boolean             @default(false)
  shouldIssueCertificateForNonPayingAttendees     Boolean             @default(false)
  shouldIssueCertificateForNonSubscribedAttendees Boolean             @default(false)
  certificateConfigs                              CertificateConfig[]

  shouldCollectAttendance   Boolean   @default(false)
  shouldAllowOralAttendance Boolean   @default(false)
  isOnlineAttendanceAllowed Boolean   @default(false)
  onlineAttendanceCode      String?
  onlineAttendanceStartDate DateTime?
  onlineAttendanceEndDate   DateTime?

  shouldProvideSubscriberListToLecturer Boolean @default(false)

  // Controls inclusion in anonymous public event listings. Audience-specific access is modeled separately.
  isPubliclyListed Boolean @default(true)
  displayLecturerProfile Boolean @default(true)

  publicationState      PublicationState @default(DRAFT)
  scheduledPublishAt    DateTime?
  publishedAt           DateTime?
  unpublishedAt         DateTime?
  publicationScheduledBy String?
  publicationUpdatedBy   String?

  youtubeCode String?
  buttonText  String?
  buttonLink  String?

  deletedAt DateTime?

  createdAt   DateTime @default(now())
  createdById String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([startDate])
  @@index([endDate])
  @@index([startDate, endDate])
  @@index([majorEventId])
  @@index([eventGroupId])
  @@index([deletedAt])
  @@index([publicationState])
  @@index([scheduledPublishAt])
  @@map("events")
}

model EventDraft {
  id String @id @default(uuid(7))

  sourceEvent   Event  @relation(fields: [sourceEventId], references: [id], onDelete: Cascade)
  sourceEventId String

  name    String
  payload Json

  createdById    String?
  createdByName  String?
  createdByEmail String?
  updatedById    String?
  updatedByName  String?
  updatedByEmail String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  expiresAt DateTime

  @@index([sourceEventId, updatedAt(sort: Desc), createdAt(sort: Desc)])
  @@index([expiresAt])
  @@map("event_drafts")
}

model PlacePreset {
  id                  String  @id @default(uuid(7))
  name                String
  latitude            Float?
  longitude           Float?
  locationDescription String?

  deletedAt DateTime?

  sportsVenues SportsVenue[]

  createdAt   DateTime @default(now())
  createdById String?
  updatedAt   DateTime @updatedAt
  updatedById String?

  @@index([name])
  @@index([name], map: "place_presets_active_name_idx", where: raw("\"deletedAt\" IS NULL"))
  @@index([deletedAt])
  @@map("place_presets")
}

model EventLecturer {
  eventId  String
  personId String

  event  Event  @relation(fields: [eventId], references: [id])
  person People @relation(fields: [personId], references: [id])

  createdAt   DateTime @default(now())
  createdById String?

  @@id([eventId, personId])
  @@index([personId])
  @@map("event_lecturers")
}

model PublicationPreview {
  id String @id(map: "public_content_previews_pkey") @default(uuid(7))

  previewTokenHash String @unique(map: "public_content_previews_previewTokenHash_key")
  targetType        PublicationPreviewTargetType
  targetId          String
  targetLabel       String

  previewAt DateTime?
  publicPath String
  redisKey   String

  createdById    String
  createdByName  String?
  createdByEmail String?

  expiresAt  DateTime
  trimAfter  DateTime
  lastUsedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([targetType, targetId, createdById], map: "public_content_previews_targetType_targetId_createdById_key")
  @@index([targetType, targetId], map: "public_content_previews_targetType_targetId_idx")
  @@index([expiresAt], map: "public_content_previews_expiresAt_idx")
  @@index([trimAfter], map: "public_content_previews_trimAfter_idx")
  @@map("publication_previews")
}

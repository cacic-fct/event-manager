generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["partialIndexes"]
}

generator erd {
  provider                  = "prisma-erd-generator"
  output                    = "database-erd.md"
  disableEmoji              = true
  includeRelationFromFields = true
}

datasource db {
  provider = "postgresql"
}

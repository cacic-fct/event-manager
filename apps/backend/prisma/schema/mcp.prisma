enum McpAdminCapability {
  EVENT_READ
  ATTENDANCE_READ
  DESCRIPTION_PROPOSE
  PREPARATION_READ
  MATERIALS_READ
  SUBSCRIPTIONS_READ
  FORMS_READ
  CONTENT_REVIEWS_READ
  EVENT_CONTENT_PROPOSE
  LOCATION_PROPOSE
  PREPARATION_PROPOSE
  LIVESTREAM_PROPOSE
}

enum McpProposalOperation {
  EVENT_DESCRIPTION
  EVENT_CONTENT
  EVENT_LOCATION
  EVENT_PREPARATION
  EVENT_LIVESTREAM
}

enum McpProposalState {
  PENDING
  APPLIED
  REJECTED
}

model McpAdminDelegation {
  id           String               @id @default(uuid(7))
  userId       String
  clientId     String
  resource     String
  eventIds     String[]
  capabilities McpAdminCapability[]
  maxProposals Int
  createdAt    DateTime             @default(now())
  expiresAt    DateTime
  revokedAt    DateTime?
  proposals    McpAdminProposal[]

  @@index([userId, createdAt])
  @@index([userId, clientId, expiresAt])
  @@index([expiresAt])
  @@map("mcp_admin_delegations")
}

model McpAdminProposal {
  operation         McpProposalOperation @default(EVENT_DESCRIPTION)
  beforeValues      Json?
  afterValues       Json?
  id                String             @id @default(uuid(7))
  delegationId      String
  delegation        McpAdminDelegation @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  eventId           String
  event             Event              @relation(fields: [eventId], references: [id], onDelete: Cascade)
  idempotencyKey    String
  descriptionBefore String?
  descriptionAfter  String
  baseUpdatedAt     DateTime
  state             McpProposalState   @default(PENDING)
  createdAt         DateTime           @default(now())
  expiresAt         DateTime
  decidedAt         DateTime?
  approvedById      String?
  approvedByName    String?

  @@unique([delegationId, idempotencyKey])
  @@index([delegationId, createdAt])
  @@index([eventId, state])
  @@index([expiresAt])
  @@map("mcp_admin_proposals")
}

// Event-only recovery survives erasure of personal delegations and proposals.
model McpEventContentSync {
  eventId    String    @id
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  revision   Int       @default(1)
  leaseUntil DateTime?
  createdAt  DateTime  @default(now())

  @@index([leaseUntil, createdAt])
  @@map("mcp_event_content_sync")
}

// Security evidence only: never store bearer tokens, arguments or tool results.
model McpAdminOperationLog {
  id           String   @id @default(uuid(7))
  userId       String?
  clientId     String?
  delegationId String?
  tool         String
  eventId      String?
  proposalId   String?
  outcome      String
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("mcp_admin_operation_logs")
}

model McpAdminOperationDelegation {
  id            String   @id @default(uuid(7))
  userId        String
  clientId      String
  resource      String
  operations    String[]
  scope         Json
  personalData  Boolean  @default(false)
  maxProposals  Int
  createdAt     DateTime @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  proposals     McpAdminCommand[]

  @@index([userId, clientId, expiresAt])
  @@index([expiresAt])
  @@map("mcp_admin_operation_delegations")
}

model McpAdminCommand {
  id             String   @id @default(uuid(7))
  delegationId   String
  delegation     McpAdminOperationDelegation @relation(fields: [delegationId], references: [id], onDelete: Cascade)
  operation      String
  arguments      Json
  fingerprint    String
  idempotencyKey String
  state          String   @default("PENDING")
  createdAt      DateTime @default(now())
  expiresAt      DateTime
  decidedAt      DateTime?
  approvedById   String?
  approvedByName String?
  reviewedArguments Json?

  @@unique([delegationId, idempotencyKey])
  @@index([delegationId, createdAt])
  @@index([state, decidedAt])
  @@index([expiresAt])
  @@map("mcp_admin_commands")
}

model EventAttendance {
  personId String
  eventId  String

  person People @relation(fields: [personId], references: [id])
  event  Event  @relation(fields: [eventId], references: [id])

  category AttendanceCategory    @default(UNKNOWN)
  status   EventAttendanceStatus @default(PRESENT)

  attendedAt DateTime @default(now())

  createdAt       DateTime                 @default(now())
  createdById     String?
  committedById   String?
  createdByMethod AttendanceCreationMethod @default(UNKNOWN)

  collectedLatitude       Float?
  collectedLongitude      Float?
  // Generated by PostgreSQL from the collected coordinate pair.
  collectedLocation       Unsupported("geography")? @default(dbgenerated("\nCASE\n    WHEN (\"collectedLatitude\" IS NULL) THEN NULL::geography\n    ELSE (st_setsrid(st_makepoint(\"collectedLongitude\", \"collectedLatitude\"), 4326))::geography\nEND"))
  collectedAccuracyMeters Float?

  @@id([personId, eventId])
  @@index([eventId])
  @@index([eventId, status])
  @@index([personId])
  @@index([committedById])
  @@index([collectedLocation], map: "event_attendances_collected_location_gist_idx", type: Gist)
  @@map("event_attendances")
}

model EventAttendanceCollector {
  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  personId String
  person   People @relation(fields: [personId], references: [id])

  createdAt   DateTime @default(now())
  createdById String?

  @@id([eventId, personId])
  @@index([personId])
  @@map("event_attendance_collectors")
}

model OfflineEventAttendanceSubmission {
  id String @id @default(uuid(7))

  clientId String

  eventId String
  event   Event  @relation(fields: [eventId], references: [id])

  personId String?
  person   People? @relation(fields: [personId], references: [id])

  status OfflineEventAttendanceSubmissionStatus @default(PENDING)

  createdByMethod AttendanceCreationMethod
  scannerCode     String?
  manualValue     String?
  collectedAt     DateTime

  authorUserId String?
  authorName   String?
  authorEmail  String?

  submittedById String
  submittedAt   DateTime @default(now())

  stagedReason    String?
  resolutionError String?

  collectedLatitude       Float?
  collectedLongitude      Float?
  // Generated by PostgreSQL from the collected coordinate pair.
  collectedLocation       Unsupported("geography")? @default(dbgenerated("\nCASE\n    WHEN (\"collectedLatitude\" IS NULL) THEN NULL::geography\n    ELSE (st_setsrid(st_makepoint(\"collectedLongitude\", \"collectedLatitude\"), 4326))::geography\nEND"))
  collectedAccuracyMeters Float?

  committedAt   DateTime?
  committedById String?

  rejectedAt      DateTime?
  rejectedById    String?
  rejectionReason String?

  @@unique([submittedById, clientId])
  // Offline device command IDs are globally unique so a later authorized
  // uploader cannot replay the same command as a fresh submission.
  @@unique([clientId], map: "offline_event_attendance_submissions_client_id_key")
  @@index([eventId, status])
  @@index([personId])
  @@index([submittedById])
  @@index([committedById])
  @@index([rejectedById])
  @@index([collectedLocation], map: "offline_attendance_collected_location_gist_idx", type: Gist)
  @@map("offline_event_attendance_submissions")
}

enum AttendanceCreationMethod {
  CSV_IMPORT
  EVENT_DUPLICATION
  MANUAL_INPUT
  ORAL_CALL
  SCANNER
  ONLINE_CODE
  UNKNOWN
}

enum EventAttendanceStatus {
  PRESENT
  ABSENT
}

enum AttendanceCategory {
  NON_PAYING
  NON_SUBSCRIBED
  REGULAR
  UNKNOWN
}

enum OfflineEventAttendanceSubmissionStatus {
  PENDING
  COMMITTED
  REJECTED
}

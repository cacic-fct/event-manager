  WAITING_PAYMENT
  UNDER_REVIEW
  PAID
  REJECTED
}

enum SportsTeamMemberStatus {
  PENDING
  APPROVED
  CHANGES_REQUESTED
  REJECTED
  SUSPENDED
  WITHDRAWN
}

enum SportsRosterRole {

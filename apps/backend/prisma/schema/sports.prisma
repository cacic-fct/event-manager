  REJECTED
  SUPERSEDED
}

enum SportsTeamChangeRequestType {
  TEAM_DETAILS
  MEMBER_ADD
  MEMBER_UPDATE
  MEMBER_REMOVE
  LOGO
  REPRESENTATIVE
  CATEGORY_ROLE
  LINEUP
}

enum SportsIdentityType {

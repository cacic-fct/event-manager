  NO_SHOW
  OTHER
}

enum SportsRosterStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CONFLICT
}

enum SportsRosterEntryStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum SportsStageType {
  GROUP
  ELIMINATION

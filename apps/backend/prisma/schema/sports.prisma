  REJECTED
}

enum SportsMatchActionType {
  CHECK_IN
  START
  PAUSE
  RESUME
  SCORE_DELTA
  SCORE_CORRECTION
  PERIOD_ROLL
  TIMER_RECONCILE
  OCCURRENCE
  FINALIZE
  CANCEL
  RESCHEDULE
  FORFEIT
  RESET
}

enum SportsLivestreamProvider {

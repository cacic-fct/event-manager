    "test:data-transfer:runner": "node --test tools/run-data-transfer-database-tests.test.mjs",
    "typecheck:data-import": "bunx tsc -p tools/data-import/tsconfig.json",
    "prepare": "node -e \"if (require('node:fs').existsSync('.git')) import('./.husky/install.mjs')\"",
    "format:staged": "node node_modules/lint-staged/bin/lint-staged.js"
  },
